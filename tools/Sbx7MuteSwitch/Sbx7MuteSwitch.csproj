<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Sbx7MuteSwitch</AssemblyName>
    <RootNamespace>Sbx7MuteSwitch</RootNamespace>
    <InteropCtSndCrPath Condition="'$(InteropCtSndCrPath)' == ''">$(INTEROP_CT_SNDCR_PATH)</InteropCtSndCrPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="Interop.CtSndCr">
      <HintPath>$(InteropCtSndCrPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CheckInteropPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(InteropCtSndCrPath)' == ''"
           Text="Set InteropCtSndCrPath (or the INTEROP_CT_SNDCR_PATH environment variable) to the installed Interop.CtSndCr.dll." />
  </Target>
</Project>